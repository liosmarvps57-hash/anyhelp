# Copie para .env e ajuste.

# IP público (ou domínio) da VPS. É o mesmo valor da variável ANYHELP_SERVER no GitHub.
ANYHELP_HOST=203.0.113.10

# Imagem do servidor. Para travar a versão, troque latest por uma tag (ex.: 1.1.16)
# depois de confirmar que ela existe em https://hub.docker.com/r/rustdesk/rustdesk-server/tags
SERVER_IMAGE=rustdesk/rustdesk-server:latest

# Limites do relay em Mb/s
#   TOTAL_BANDWIDTH  banda total que o relay pode usar (deixe ~80% do link da VPS)
#   SINGLE_BANDWIDTH teto por sessão
#   LIMIT_SPEED      velocidade mínima garantida por sessão quando o relay está cheio
TOTAL_BANDWIDTH=1024
SINGLE_BANDWIDTH=128
LIMIT_SPEED=32
